<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MegaDl.Desktop.App"
             RequestedThemeVariant="Default">
  <!-- "Default" follows the OS light/dark setting. -->

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MegaDl/Styles/AppStyles.axaml" />
  </Application.Styles>
</Application>
